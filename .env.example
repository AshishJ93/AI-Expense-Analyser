# Copy to .env for local use. Never commit real keys.
# Totals, charts, and recommendations work with this file empty.
# The written briefing uses xAI when a key is present.

HISAABPEHLE_LLM_PROVIDER=xai
XAI_API_KEY=
HISAABPEHLE_LLM_BASE_URL=https://api.x.ai/v1
HISAABPEHLE_LLM_MODEL=grok-4-1-fast-non-reasoning

# Other providers, if you replace the values above:
# HISAABPEHLE_LLM_PROVIDER=openai
# HISAABPEHLE_LLM_API_KEY=
# HISAABPEHLE_LLM_BASE_URL=https://api.openai.com/v1
# HISAABPEHLE_LLM_MODEL=gpt-4o-mini
